DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
BOT_TOKEN="123456:your-telegram-bot-token"
PORT=4000
NODE_ENV=development
ADMIN_ORIGIN="http://localhost:5174"
MINIAPP_ORIGIN="http://localhost:5173"
MINIAPP_PUBLIC_URL="http://localhost:5173"

# Auth — generate a long random string for JWT_SECRET in production
JWT_SECRET="change-me-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Business branding defaults (used only the first time Settings is created —
# afterwards edit them from the Admin Dashboard's Settings page)
BUSINESS_NAME="My Business"
BUSINESS_TYPE="food"
BUSINESS_CURRENCY="UZS"

# Optional: comma-separated Telegram chat IDs to receive "new order" alerts
ADMIN_CHAT_IDS=""

# Optional: set only when deploying with a webhook instead of polling
# BOT_WEBHOOK_URL="https://your-backend-domain.com"
